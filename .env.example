# Server
PORT=3000
NODE_ENV=development

# Neon / Postgres
PGUSER=
PGPASSWORD=
PGHOST=
PGDATABASE=

# Arcjet
ARCJET_KEY=

# Shopify (Partner + Admin dashboards). See SHOPIFY.md
SHOPIFY_ENABLED=true
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2025-01

# Headless storefront (Products, Cart, Checkout URL)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Admin API (product sync into Postgres). Use a custom app Admin API access token.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Webhook HMAC secret (from custom app / webhook settings)
SHOPIFY_WEBHOOK_SECRET=
